# .env.example for yucer - authoritative reference for every supported
# variable. Copy to .env and fill in. .env is git-ignored and never committed.
# Convention: values below are the prod defaults; a "BETA OVERRIDES" note marks
# any key whose beta value differs. Secret keys are present-but-empty with a
# procurement note; real values are injected via env, never committed.

# --- App ---
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production          # BETA OVERRIDES: beta
APP_PUBLISH_PORT=<assigned-at-registration>

# --- Database (yucer) ---
# Runtime connects as the least-privilege service role, not the DB owner.
POSTGRES_DB=vxturebiz_yucer_prod     # BETA OVERRIDES: vxturebiz_yucer_beta
POSTGRES_USER=yucer_svc
POSTGRES_PASSWORD=                      # procure: YUCER_DB_SVC_PASSWORD
DATABASE_URL=postgresql://yucer_svc:@yucer-db:5432/vxturebiz_yucer_prod

# --- Redis (RP session store) ---
REDIS_URL=redis://yucer-redis:6379

# --- Status dashboard (/status, /api/status) ---
STATUS_PAGE=public                       # public | authed (login required) | off
STATUS_SHOW_INFRA=on                     # on shows db host/name/role; off hides them

# --- C1 OIDC RP (080-rp section 2.11) ---
OIDC_ISSUER=https://accounts.vxture.com
OIDC_CLIENT_ID=yucer                   # BETA OVERRIDES: yucer-beta
OIDC_CLIENT_SECRET=                      # procure: platform-issued client secret
OIDC_REDIRECT_URI=https://yucer.vxture.com/auth/callback
OIDC_SCOPES=openid profile email phone
OIDC_POST_LOGOUT_REDIRECT_URI=https://yucer.vxture.com/
OIDC_RP_ENABLED=on
RP_SESSION_TTL=2592000
RP_SESSION_COOKIE_NAME=__Host-vx_rp_session   # dev over http: vx_rp_session
NEXT_PUBLIC_APP_URL=https://yucer.vxture.com

# --- C2 entitlement / platform client ---
PLATFORM_API_URL=                        # internal-network base; unset -> Mock resolver
PLATFORM_INTERNAL_AUTH_TOKEN=            # procure: shared internal-auth secret (S2S)
NEXT_PUBLIC_CONSOLE_URL=https://console.vxture.com

# --- C3 provisioning webhook / usage ---
PROVISION_WEBHOOK_SECRET=               # procure: YUCER_PROVISION_WEBHOOK_SECRET (platform key)
PROVISION_WEBHOOK_SECRET_NEXT=          # optional, rotation overlap
INTERNAL_JOB_TOKEN=                     # procure: gates POST /api/usage/flush

# --- Demo data (offline only) ---
# Fills the in-memory stores with one complete traceable chain so the product can
# be seen before a database exists. Guarded twice: this must be the literal "on",
# AND DATABASE_URL must be unset. A workspace with a real database is never
# seeded. Leave unset in any environment that has data of its own.
YUCER_DEMO_DATA=

# --- S2S token minting for the agent planes (ADR-004) ---
# Atlas and Runos both verify, neither issues: the platform IdP signs the ticket
# and each service checks iss/aud/scope/mode/act.sub. act.sub is the product code
# and is what both platforms hang authorization on.
S2S_TOKEN_URL=                          # default: ${OIDC_ISSUER}/oidc/token
S2S_CLIENT_ID=                          # default: OIDC_CLIENT_ID
S2S_CLIENT_SECRET=                      # procure: OIDC_CLIENT_SECRET_<CLIENT>; the
                                        # unsuffixed secret against a different
                                        # client_id yields invalid_client
PRODUCT_CODE=yucer                      # act.sub on every minted ticket

# --- Atlas (L1 model plane; the ONLY LLM exit) ---
# Tailnet-internal today - atlas.vxture.com is reserved but unbound, so take the
# base URL from the deployment and never hardcode it. Unset -> model calls fail
# loudly with ATLAS_NOT_CONFIGURED rather than silently doing nothing.
# PREREQUISITE: a (yucer, endpointCode) product-grant must exist on the Atlas
# side, or every call is 403 GRANT_DENIED regardless of the token.
ATLAS_BASE_URL=
ATLAS_TIMEOUT_MS=60000
ATLAS_MAX_RETRIES=2
# Task -> endpoint routing. endpointCode only, never modelCode: a pinned model
# forfeits the endpoint's fallback chain and blocks an operator re-pointing it.
ATLAS_ENDPOINT_CHAT=chat/default        # member Q&A in a session
ATLAS_ENDPOINT_PROPOSE=chat/reasoning   # agent_action proposals (a human signs for these)
ATLAS_ENDPOINT_SCORE=chat/fast          # bulk signal scoring; cost per call dominates
ATLAS_ENDPOINT_SUMMARIZE=chat/default   # win/loss and account digests

# --- Runos (L1 commercial capability plane; connectors, skills, executors) ---
# Also tailnet-internal. Runos production catalog starts empty with enforcement
# off: until an operator registers a capability, grants it to the `yucer`
# product, and enables enforcement, runos_discover returns an empty list. That
# is a normal response, not a fault.
RUNOS_BASE_URL=
RUNOS_MCP_PATH=/v1/mcp
RUNOS_TIMEOUT_MS=60000
RUNOS_AGENT_VERSION=                    # optional, attribution only
