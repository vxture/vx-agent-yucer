// ===== local_audit =====

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz()
  actorId      String   @map("actor_id") @db.VarChar(128)
  actorConsole String?  @map("actor_console") @db.VarChar(64)
  objectType   String   @map("object_type") @db.VarChar(64)
  objectId     String   @map("object_id") @db.VarChar(128)
  action       String   @db.VarChar(128)
