// ===== yucer_agent (D8 sales copilot) =====

model AgentSession {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  actorSub    String   @map("actor_sub") @db.VarChar(128)
  subjectType String?  @map("subject_type") @db.VarChar(32)
  subjectId   String?  @map("subject_id") @db.Uuid
  title       String?  @db.VarChar(255)
  status      String   @default("open") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("agent_session")
  @@schema("yucer_agent")
}

model AgentMessage {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  seq         BigInt
  role        String   @db.VarChar(32)
  content     String   @db.Text
  tokenCount  Int?     @map("token_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([sessionId, seq], map: "uidx_agent_message_session_seq")
  @@map("agent_message")
  @@schema("yucer_agent")
}

model AgentAutonomy {
  workspaceId  String   @id @map("workspace_id") @db.Uuid
  mode         String   @default("ask_always") @db.VarChar(32)
  decidedBySub String?  @map("decided_by_sub") @db.VarChar(128)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("agent_autonomy")
  @@schema("yucer_agent")
}

model AgentAction {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  sessionId    String?   @map("session_id") @db.Uuid
  actionType   String    @map("action_type") @db.VarChar(64)
  subjectType  String    @map("subject_type") @db.VarChar(32)
  subjectId    String    @map("subject_id") @db.Uuid
  payload      Json      @default("{}") @db.JsonB
  rationale    String?   @db.Text
  confidence   Int?      @db.SmallInt
  status       String    @default("proposed") @db.VarChar(32)
  /// Which capability proposed this - ADR-015. Nullable: historical rows have
  /// none, and a backfilled guess would manufacture accuracy data.
  capability   String?   @db.VarChar(64)
  decidedBySub String?   @map("decided_by_sub") @db.VarChar(128)
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz()
  executedAt   DateTime? @map("executed_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@index([workspaceId, capability, status], map: "agent_action_by_capability")
  @@map("agent_action")
  @@schema("yucer_agent")
}

/// How we intend to work one strategic customer - see ADR-013.
///
/// The cadence fields are the reason this table exists: every other judgement
/// rule is event-triggered and needs an open opportunity, which makes a locked-in
/// customer with no live deal invisible exactly when that is worth reporting.
model AccountPlan {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  period             String   @db.VarChar(16)
  targetAmount       Decimal? @map("target_amount") @db.Decimal(18, 2)
  currency           String   @default("CNY") @db.VarChar(8)
  contactCadenceDays Int      @default(30) @map("contact_cadence_days")
  execCadenceDays    Int      @default(90) @map("exec_cadence_days")
  ownerSub           String?  @map("owner_sub") @db.VarChar(128)
  presalesSub        String?  @map("presales_sub") @db.VarChar(128)
  deliverySub        String?  @map("delivery_sub") @db.VarChar(128)
  chainGoal          String?  @map("chain_goal") @db.Text
  targetLines        String?  @map("target_lines") @db.Text
  status             String   @default("active") @db.VarChar(16)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, accountId, period], map: "account_plan_unique")
  @@index([workspaceId, status], map: "account_plan_active")
  @@map("account_plan")
  @@schema("yucer_core")
}

/// A member deferring one derived judgement - see incr/0005_judgement_snooze.sql.
///
/// judgementId is TEXT, not a UUID: judgements are recomputed from evidence on
/// every request and have no row of their own, so this references a conclusion
/// rather than a record. urgencyAtSnooze is what makes that safe - the snooze
/// ends early if the tier escalates.
model JudgementSnooze {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  sub             String   @db.Text
  judgementId     String   @map("judgement_id") @db.Text
  urgencyAtSnooze String   @map("urgency_at_snooze") @db.Text
  snoozedUntil    DateTime @map("snoozed_until") @db.Timestamptz()
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([workspaceId, sub, judgementId], map: "judgement_snooze_unique")
  @@index([workspaceId, sub, snoozedUntil], map: "judgement_snooze_live")
  @@map("judgement_snooze")
  @@schema("yucer_agent")
}

model AgentPlaybook {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  playbookCode String   @map("playbook_code") @db.VarChar(64)
  name         String   @db.VarChar(255)
  scopeDomain  String   @map("scope_domain") @db.VarChar(32)
  trigger      Json     @default("{}") @db.JsonB
  content      String   @db.Text
  version      Int      @default(1)
  status       String   @default("draft") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, playbookCode], map: "uidx_agent_playbook_ws_code")
  @@map("agent_playbook")
  @@schema("yucer_agent")
}

// ===== yucer_field (ADR-006) =====
// The evidence plane. Client-generation only - structure lives in
// deploy/database/ddl/incr/0004_field_evidence.sql, which also carries this
// schema's grants and locks because db-init applies 97/98 before incr/.

model Interaction {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  accountId             String    @map("account_id") @db.Uuid
  opportunityId         String?   @map("opportunity_id") @db.Uuid
  projectId             String?   @map("project_id") @db.Uuid
  channel               String    @db.VarChar(32)
  direction             String    @default("outbound") @db.VarChar(16)
  occurredAt            DateTime  @map("occurred_at") @db.Timestamptz(6)
  actorSub              String    @map("actor_sub") @db.VarChar(128)
  subject               String?   @db.VarChar(255)
  rawNote               String    @map("raw_note")
  summary               String?
  captureMode           String    @default("manual") @map("capture_mode") @db.VarChar(32)
  correctsInteractionId String?   @map("corrects_interaction_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, accountId, occurredAt(sort: Desc)])
  @@map("interaction")
  @@schema("yucer_field")
}

model InteractionParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  interactionId String   @map("interaction_id") @db.Uuid
  contactId     String?  @map("contact_id") @db.Uuid
  memberSub     String?  @map("member_sub") @db.VarChar(128)
  externalName  String?  @map("external_name") @db.VarChar(255)
  roleAtTime    String?  @map("role_at_time") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([interactionId, contactId, memberSub, externalName], map: "uidx_participant_edge")
  @@index([workspaceId, contactId])
  @@map("interaction_participant")
  @@schema("yucer_field")
}

model Commitment {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  accountId            String    @map("account_id") @db.Uuid
  opportunityId        String?   @map("opportunity_id") @db.Uuid
  originInteractionId  String?   @map("origin_interaction_id") @db.Uuid
  direction            String    @db.VarChar(16)
  statement            String
  ownerSub             String?   @map("owner_sub") @db.VarChar(128)
  counterpartContactId String?   @map("counterpart_contact_id") @db.Uuid
  dueAt                DateTime  @map("due_at") @db.Timestamptz(6)
  status               String    @default("open") @db.VarChar(32)
  closureEvidenceKind  String?   @map("closure_evidence_kind") @db.VarChar(32)
  closureEvidenceId    String?   @map("closure_evidence_id") @db.Uuid
  metAt                DateTime? @map("met_at") @db.Timestamptz(6)
  waivedBySub          String?   @map("waived_by_sub") @db.VarChar(128)
  waiveReason          String?   @map("waive_reason")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, dueAt])
  @@map("commitment")
  @@schema("yucer_field")
}

/// The product catalogue - see ADR-014.
///
/// Nothing to do with the platform's vx_provision.product_code: one says who we
/// sell this SaaS to, the other says what the company using it sells.
model Product {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  productCode  String   @map("product_code") @db.VarChar(64)
  name         String   @db.VarChar(255)
  /// The type association - a uuid since 0029; the business code never joins.
  typeId       String?  @map("type_id") @db.Uuid
  unit         String   @default("set") @db.VarChar(32)
  /// The status association - a uuid like the type's (0029).
  statusId     String   @map("status_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, productCode], map: "uidx_product_code")
  @@index([workspaceId, sortOrder], map: "idx_product_ws_sort")
  @@index([workspaceId, typeId], map: "idx_product_ws_type")
  @@index([workspaceId, statusId], map: "idx_product_ws_status")
  @@map("product")
  @@schema("yucer_catalog")
}

/// The workspace's own type vocabulary - incr/0028. `category` on Product
/// holds a type_code by value (no FK: types retire, never delete).
model ProductType {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  typeCode    String   @map("type_code") @db.VarChar(64)
  name        String   @db.VarChar(64)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("active") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, typeCode], map: "uidx_product_type_code")
  @@index([workspaceId, sortOrder], map: "idx_product_type_ws_sort")
  @@map("product_type")
  @@schema("yucer_catalog")
}

/// The workspace's status vocabulary - incr/0029. Rows ARE the content:
/// code (anchor), name, 状态描述, order. The three canonical rows are
/// rule-protected from deletion; everything else is the workspace's.
model ProductStatus {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  statusCode  String   @map("status_code") @db.VarChar(32)
  name        String   @db.VarChar(64)
  description String?  @db.VarChar(255)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, statusCode], map: "uidx_product_status_code")
  @@index([workspaceId, sortOrder], map: "idx_product_status_ws_sort")
  @@map("product_status")
  @@schema("yucer_catalog")
}

/// A quoting template. Lines never reference it for calculation - ADR-014 s4.
model Solution {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  solutionCode String   @map("solution_code") @db.VarChar(64)
  name         String   @db.VarChar(255)
  summary      String?  @db.Text
  status       String   @default("active") @db.VarChar(16)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, solutionCode], map: "uidx_solution_code")
  @@map("solution")
  @@schema("yucer_catalog")
}

model SolutionItem {
  id          String  @id @default(uuid()) @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  solutionId  String  @map("solution_id") @db.Uuid
  productId   String  @map("product_id") @db.Uuid
  quantity    Decimal @default(1) @db.Decimal(12, 2)

  @@unique([solutionId, productId], map: "uidx_solution_item")
  @@map("solution_item")
  @@schema("yucer_catalog")
}

/// list_price and FLOOR. The floor is what makes this table carry a decision.
model PriceBookEntry {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  currency    String   @default("CNY") @db.VarChar(8)
  listPrice   Decimal  @map("list_price") @db.Decimal(18, 2)
  floorPrice  Decimal  @map("floor_price") @db.Decimal(18, 2)
  effectiveAt DateTime @default(now()) @map("effective_at") @db.Timestamptz()

  @@unique([workspaceId, productId, currency, effectiveAt], map: "uidx_price_entry")
  @@map("price_book_entry")
  @@schema("yucer_catalog")
}

/// When lines exist they are AUTHORITATIVE and opportunity.amount is their sum.
/// Reconciled in the service, not by a trigger - ADR-014 s2.
model OpportunityLine {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  opportunityId  String   @map("opportunity_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  solutionId     String?  @map("solution_id") @db.Uuid
  quantity       Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @default("CNY") @db.VarChar(8)
  needsApproval  Boolean  @default(false) @map("needs_approval")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@index([workspaceId, opportunityId], map: "opportunity_line_by_opp")
  @@index([workspaceId, productId], map: "opportunity_line_by_product")
  @@map("opportunity_line")
  @@schema("yucer_pipeline")
}

/// incr/0012. Append-only: no update, no delete. Keyed by the price signed off,
/// not by the line, so it survives the replace-not-patch rewrite of lines.
model LineDiscountApproval {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  opportunityId  String   @map("opportunity_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  currency       String   @default("CNY") @db.VarChar(8)
  floorPrice     Decimal  @map("floor_price") @db.Decimal(18, 2)
  reason         String
  approvedBySub  String   @map("approved_by_sub") @db.VarChar(255)
  approvedAt     DateTime @default(now()) @map("approved_at") @db.Timestamptz()

  @@index([workspaceId, opportunityId], map: "line_discount_approval_by_opp")
  @@map("line_discount_approval")
  @@schema("yucer_pipeline")
}
