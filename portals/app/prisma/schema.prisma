}

// ###########################################################################
// PRODUCT DOMAIN MODELS (yucer) - lockstep mirror of the "PRODUCT DOMAIN
// SCHEMAS" section of deploy/database/ddl/00_baseline.sql. Adding a model here
// without its DDL table (or the reverse) fails check-data-architecture.mjs.
//
// Foreign keys are modelled as SCALAR columns only, with no `@relation` blocks -
// the same pattern the contract-schema models above use (see MemberRole). The
// DDL owns referential integrity; Prisma here is a client-generation source, not
// the structure authority, so relation navigation is deliberately not declared.
// ###########################################################################

// ===== yucer_core (D4 account management) =====

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  accountNo    String    @map("account_no") @db.VarChar(64)
  name         String    @db.VarChar(255)
  industry     String?   @db.VarChar(64)
  region       String?   @db.VarChar(64)
  segmentCode  String?   @map("segment_code") @db.VarChar(64)
  ownerSub     String?   @map("owner_sub") @db.VarChar(128)
  /// strategic | key | standard. Set by D1, not by the owner - see ADR-013.
  tier         String    @default("standard") @db.VarChar(16)
  healthScore  Int?      @map("health_score") @db.SmallInt
  /// incr/0024. 统一社会信用代码 for a mainland entity; unconstrained in shape
  /// because a foreign counterparty registers somewhere else entirely.
  creditCode   String?   @map("credit_code") @db.VarChar(64)
  website      String?   @db.VarChar(255)
  /// A count, not a band. Bands derive from a count; a count never derives
  /// from a band, and naming the bands is the owner's call - see incr/0024.
  employeeCount Int?     @map("employee_count")
  /// incr/0025. Self-referencing, ON DELETE SET NULL: deleting a parent
  /// orphans its subsidiaries rather than deleting customers in their own right.
  parentId     String?   @map("parent_id") @db.Uuid
  status       String    @default("prospect") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  @@unique([workspaceId, accountNo], map: "uidx_account_ws_no")
  @@map("account")
  @@schema("yucer_core")
}

/// incr/0026, ADR-024 batch C. This model WAS Contact and is the same table
/// under a new name - the migration is an ALTER TABLE ... RENAME, so every
/// id is unchanged and the four foreign keys from the evidence tables
/// (account_relation x2, commitment, interaction_participant) still resolve
/// without a single row being rewritten. Those tables have no UPDATE grant on
/// their attribution columns, which is why a new table was never an option.
///
/// A person has a name and a way to reach them, and nothing about any deal.
/// decision_role and influence left with incr/0028: a buying role exists only
/// relative to a purchase, so it lives on OpportunityContact.
model Person {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  name         String    @db.VarChar(255)
  /// incr/0024. No format constraints - see that increment on why a CHECK on
  /// an email behaves like an outage.
  email        String?   @db.VarChar(255)
  mobile       String?   @db.VarChar(64)
  wechat       String?   @db.VarChar(128)
  status       String    @default("active") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  @@map("person")
  @@schema("yucer_core")
}

/// Where a person works, with a start and an end - incr/0026.
///
/// EMPLOYMENT IS HISTORY, NOT A COLUMN. Changing employer used to mean
/// overwriting contact.account_id, which destroyed the fact a salesperson most
/// wants ("three months ago he was still at 长江物流"). It is now a new row and
/// an ended_at on the old one, so "where is he now" and "where was he when he
/// promised us that" are the same query at two instants.
///
/// person_id and account_id have NO UPDATE grant: the pair IS the edge, and
/// editing it would rewrite history rather than record a change.
model PersonAffiliation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  personId    String    @map("person_id") @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  title       String?   @db.VarChar(255)
  department  String?   @db.VarChar(128)
  isPrimary   Boolean   @default(true) @map("is_primary")
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  /// NULL is current. Not a sentinel date - an employment with no end has no
  /// end, and 9999-12-31 makes every range comparison wrong at the edges.
  endedAt     DateTime? @map("ended_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("person_affiliation")
  @@schema("yucer_core")
}

/// A person's role on ONE deal - incr/0027, ADR-024 batch D.
///
/// The role a buying-influence method assigns is per-purchase by definition:
/// the same person can be the economic buyer on one deal and a user on the
/// next. Before this, the role lived on the person and three concurrent deals
/// at one customer shared a single decision chain.
///
/// yucer_pipeline because the row is about a DEAL (D6), not about the person.
/// Absence is meaningful: no row means this deal has not distinguished itself
/// from the customer-level default on person.decision_role.
model OpportunityContact {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  opportunityId String   @map("opportunity_id") @db.Uuid
  personId      String   @map("person_id") @db.Uuid
  buyingRole    String   @default("unknown") @map("buying_role") @db.VarChar(32)
  influence     Int?     @db.SmallInt
  isPrimary     Boolean  @default(false) @map("is_primary")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([opportunityId, personId], map: "uidx_opportunity_contact_pair")
  @@map("opportunity_contact")
  @@schema("yucer_pipeline")
}

model AccountRelation {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  fromContactId String   @map("from_contact_id") @db.Uuid
  toContactId   String   @map("to_contact_id") @db.Uuid
  relationType  String   @map("relation_type") @db.VarChar(32)
  strength      Int?     @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([fromContactId, toContactId, relationType], map: "uidx_account_relation_edge")
  @@map("account_relation")
  @@schema("yucer_core")
}

// ===== yucer_gtm (D1 strategy, D2 planning, D3 campaign) =====

model StrategyPlan {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  planNo      String    @map("plan_no") @db.VarChar(64)
  name        String    @db.VarChar(255)
  period      String    @db.VarChar(32)
  objective   String?   @db.Text
  ownerSub    String?   @map("owner_sub") @db.VarChar(128)
  status      String    @default("draft") @db.VarChar(32)
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, planNo], map: "uidx_strategy_plan_ws_no")
  @@map("strategy_plan")
  @@schema("yucer_gtm")
}

model MarketSegment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  segmentCode String   @map("segment_code") @db.VarChar(64)
  name        String   @db.VarChar(255)
  planId      String?  @map("plan_id") @db.Uuid
  criteria    Json     @default("{}") @db.JsonB
  priority    Int      @default(0) @db.SmallInt
  status      String   @default("active") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, segmentCode], map: "uidx_market_segment_ws_code")
  @@map("market_segment")
  @@schema("yucer_gtm")
}

model Territory {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  territoryCode String   @map("territory_code") @db.VarChar(64)
  name          String   @db.VarChar(255)
  parentId      String?  @map("parent_id") @db.Uuid
  ownerSub      String?  @map("owner_sub") @db.VarChar(128)
  // incr/0017. The regions this territory covers - lead routing, data-scope
  // resolution and completeness derivation all read this. It existed in the
  // DDL but was never mirrored here, so PrismaPlanningStore.upsertTerritory()
  // could not write it at all (TD, see docs/60-operations/00-index.md).
  regions       Json     @default("[]") @db.JsonB
  status        String   @default("active") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, territoryCode], map: "uidx_territory_ws_code")
  @@map("territory")
  @@schema("yucer_gtm")
}

model SalesTarget {
  id           String   @id @default(uuid()) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  planId       String?  @map("plan_id") @db.Uuid
  period       String   @db.VarChar(32)
  scopeType    String   @map("scope_type") @db.VarChar(32)
  territoryId  String?  @map("territory_id") @db.Uuid
  ownerSub     String?  @map("owner_sub") @db.VarChar(128)
  metric       String   @default("revenue") @db.VarChar(64)
  targetAmount Decimal  @map("target_amount") @db.Decimal(18, 2)
  /// incr/0013: NULL for a count metric. A CHECK ties it to `metric`.
  currency     String?  @db.VarChar(8)
  status       String   @default("draft") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, period, scopeType, territoryId, ownerSub, metric], map: "uidx_sales_target_scope")
  @@map("sales_target")
  @@schema("yucer_gtm")
}

model Campaign {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  campaignNo   String    @map("campaign_no") @db.VarChar(64)
  name         String    @db.VarChar(255)
  planId       String?   @map("plan_id") @db.Uuid
  segmentId    String?   @map("segment_id") @db.Uuid
  channel      String?   @db.VarChar(64)
  budgetAmount Decimal?  @map("budget_amount") @db.Decimal(18, 2)
  currency     String    @default("CNY") @db.VarChar(8)
  ownerSub     String?   @map("owner_sub") @db.VarChar(128)
  startsAt     DateTime? @map("starts_at") @db.Timestamptz()
  endsAt       DateTime? @map("ends_at") @db.Timestamptz()
  status       String    @default("draft") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, campaignNo], map: "uidx_campaign_ws_no")
  @@map("campaign")
  @@schema("yucer_gtm")
}

model CampaignExecution {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  campaignId  String    @map("campaign_id") @db.Uuid
  title       String    @db.VarChar(255)
  actionType  String    @map("action_type") @db.VarChar(32)
  assigneeSub String?   @map("assignee_sub") @db.VarChar(128)
  dueAt       DateTime? @map("due_at") @db.Timestamptz()
  status      String    @default("pending") @db.VarChar(32)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("campaign_execution")
  @@schema("yucer_gtm")
}

// ===== yucer_pipeline (D5 signal, D6 opportunity) =====

model Signal {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  source      String   @db.VarChar(64)
  sourceRef   String?  @map("source_ref") @db.VarChar(255)
  signalType  String   @map("signal_type") @db.VarChar(32)
  accountId   String?  @map("account_id") @db.Uuid
  subject     String   @db.VarChar(255)
  payload     Json     @default("{}") @db.JsonB
  score       Int?     @db.SmallInt
  /// Which line of enquiry surfaced this - ADR-016. Orders the inbox; never
  /// enters the score.
  targeting    String?  @db.VarChar(24)
  status      String   @default("new") @db.VarChar(32)
  detectedAt  DateTime @default(now()) @map("detected_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, source, sourceRef], map: "uidx_signal_ws_source_ref")
  @@index([workspaceId, targeting, detectedAt(sort: Desc)], map: "signal_by_targeting")
  @@map("signal")
  @@schema("yucer_pipeline")
}

model Lead {
  id                     String   @id @default(uuid()) @db.Uuid
  workspaceId            String   @map("workspace_id") @db.Uuid
  leadNo                 String   @map("lead_no") @db.VarChar(64)
  companyName            String   @map("company_name") @db.VarChar(255)
  contactName            String?  @map("contact_name") @db.VarChar(255)
  accountId              String?  @map("account_id") @db.Uuid
  signalId               String?  @map("signal_id") @db.Uuid
  campaignId             String?  @map("campaign_id") @db.Uuid
  score                  Int?     @db.SmallInt
  ownerSub               String?  @map("owner_sub") @db.VarChar(128)
  status                 String   @default("new") @db.VarChar(32)
  convertedOpportunityId String?  @map("converted_opportunity_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@unique([workspaceId, leadNo], map: "uidx_lead_ws_no")
  @@map("lead")
  @@schema("yucer_pipeline")
}

model Opportunity {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  opportunityNo    String    @map("opportunity_no") @db.VarChar(64)
  name             String    @db.VarChar(255)
  accountId        String    @map("account_id") @db.Uuid
  planId           String?   @map("plan_id") @db.Uuid
  campaignId       String?   @map("campaign_id") @db.Uuid
  territoryId      String?   @map("territory_id") @db.Uuid
  // The return leg from D7. Frozen after creation like campaign_id - 0019
  // deliberately grants no UPDATE on it.
  sourceProjectId  String?   @map("source_project_id") @db.Uuid
  ownerSub         String?   @map("owner_sub") @db.VarChar(128)
  stage            String    @default("qualify") @db.VarChar(32)
  forecastCategory String    @default("pipeline") @map("forecast_category") @db.VarChar(32)
  amount           Decimal?  @db.Decimal(18, 2)
  currency         String    @default("CNY") @db.VarChar(8)
  probability      Int?      @db.SmallInt
  expectedCloseAt  DateTime? @map("expected_close_at") @db.Timestamptz()
  closedAt         DateTime? @map("closed_at") @db.Timestamptz()
  status           String    @default("open") @db.VarChar(32)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz()
