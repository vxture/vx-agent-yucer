{
  "name": "@yucer/app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p ${PORT:-4060}",
    "prisma:generate": "prisma generate",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "type-check": "prisma generate && tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-coverage \"app/**/*.test.ts\"",
    "test:lcov": "mkdir -p coverage && node --enable-source-maps --import tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"app/**/*.test.ts\"",
    "test:db": "node --import tsx --test \"app/**/*.db.test.ts\"",
    "test:db:lcov": "mkdir -p coverage && node --enable-source-maps --import tsx --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov-db.info \"app/**/*.db.test.ts\""
  },
  "dependencies": {
    "@fontsource/funnel-display": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vxture/design-system": "latest",
    "@vxture/design-ui": "latest",
    "@vxture/shared": "^2.0.0",
    "@yucer/shared": "workspace:*",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
